    "rating.explanation": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Your rating reflects your warehouse performance. It is based on the speed and quality of picking, putaway, returns inspection, and other operations.\nFewer errors and delays lead to a higher rating. It is recalculated daily using your shifts from the past month.\nYour rating affects task priority and bonus calculations."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Рейтинг — это оценка вашей работы на складе. Он складывается из скорости и качества выполнения операций: сборки, раскладки, проверки возвратов и других.\nЧем меньше ошибок и простоев, тем выше рейтинг. Значение пересчитывается каждый день по итогам смен за последний месяц.\nРейтинг влияет на приоритет при выдаче заданий и на расчёт премий."
          }
        }
      }
    },
